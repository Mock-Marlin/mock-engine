# Copy this file to .env in the directory where you run mock-engine.
# Values already set in the environment win. CLI flags win over both.

PORT=4080
GRPC_PORT=50052
HOST=127.0.0.1
WORKSPACE=default

# One file, a comma-separated list, or a directory of .json, .yaml, .yml, and .har.
# Leave this empty to serve one example of each protocol, unless a spec file is used.
MOCK_IMPORT=

# Spec file. When this is empty, ./mock-engine.yaml or ./mock-engine.yml is used if it exists.
# MOCK_CONFIG=./mock-engine.yaml

# Uncomment to keep mocks in Redis. Requires the optional ioredis package.
# REDIS_URL=redis://127.0.0.1:6379

# The client opens this editor for add and edit. vim and nano both work.
# EDITOR=nano
